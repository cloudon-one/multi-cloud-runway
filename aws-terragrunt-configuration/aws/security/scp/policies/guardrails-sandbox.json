{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "LimitInstanceTypesNonProdSOC2CC34",
            "Effect": "Deny",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringNotLike": {
                    "ec2:InstanceType": [
                        "t3.*",
                        "t3a.*",
                        "t4g.*",
                        "m5.large",
                        "m5.xlarge",
                        "m6i.large",
                        "m6i.xlarge",
                        "r6i.large",
                        "c6i.large",
                        "c6i.xlarge"
                    ]
                }
            }
        },
        {
            "Sid": "DenyLargeVolumeNonProdSOC2CC34",
            "Effect": "Deny",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:*:*:volume/*",
            "Condition": {
                "NumericGreaterThan": {
                    "ec2:VolumeSize": "500"
                }
            }
        }
    ]
}
